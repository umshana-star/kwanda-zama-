<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude hardware-backed KeyStore encrypted credentials and PIN security vaults -->
        <exclude domain="sharedpref" path="zama_auth_security_vault.xml"/>
        <exclude domain="sharedpref" path="zama_secure_credentials_vault.xml"/>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zama_secure_credentials_vault.xml"/>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
    </device-transfer>
</data-extraction-rules>
